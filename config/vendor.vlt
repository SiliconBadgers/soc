`verilator_config
// Pinned Ibex combinational scheduling cycles in the non-secure RV32M configuration.
// These waivers permit simulation scheduling, not timing/CDC or synthesis signoff.
// Keep each waiver confined to its upstream source and reported signal.
lint_off -rule UNOPTFLAT -file "*.deps/ibex/rtl/ibex_id_stage.sv" -match "*instr_executing_spec*"
lint_off -rule UNOPTFLAT -file "*.deps/ibex/rtl/ibex_controller.sv" -match "*__VdfgRegularize*"
lint_off -rule UNOPTFLAT -file "*.deps/ibex/rtl/ibex_core.sv" -match "*en_wb*"

// CV32E40P 6033d2b: preserve upstream width conversions and decoding defaults.
// These are simulation compatibility waivers, not proofs of unused states or arithmetic.
lint_off -rule WIDTHEXPAND -file "*.deps/cv32e40p/rtl/cv32e40p_fifo.sv" -lines 128
lint_off -rule WIDTHEXPAND -file "*.deps/cv32e40p/rtl/cv32e40p_prefetch_controller.sv" -lines 114
